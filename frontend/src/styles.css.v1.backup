:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#10243f;background:#f4f7fb;font-synthesis:none;text-rendering:optimizeLegibility;--navy:#0a2540;--blue:#2563eb;--cyan:#1ea7c7;--line:#dce5ef;--muted:#63758a;--green:#1f9d68;--red:#d84a4a;--amber:#c78217}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:320px;background:radial-gradient(circle at 90% 5%,rgba(37,99,235,.08),transparent 30%),#f4f7fb}button,a{font:inherit}button{cursor:pointer}a{color:inherit;text-decoration:none}.site-shell{min-height:100vh}.topbar{position:sticky;top:0;z-index:30;display:flex;align-items:center;justify-content:space-between;padding:14px clamp(22px,5vw,76px);border-bottom:1px solid rgba(220,229,239,.8);background:rgba(255,255,255,.92);backdrop-filter:blur(18px)}.brand{display:flex;align-items:center;gap:10px}.brand-mark{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;color:#fff;background:linear-gradient(140deg,var(--blue),var(--cyan));box-shadow:0 8px 22px rgba(37,99,235,.24)}.brand strong,.brand small{display:block}.brand strong{font-size:14px}.brand small{margin-top:1px;color:var(--muted);font-size:11px}.nav-links{display:flex;align-items:center;gap:24px;color:#41566f;font-size:13px;font-weight:650}.nav-links a:hover{color:var(--blue)}.github-link{display:inline-flex;align-items:center;gap:7px;padding:9px 13px;border:1px solid var(--line);border-radius:9px;background:#fff}.hero{display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center;min-height:690px;padding:88px clamp(22px,7vw,110px);overflow:hidden}.eyebrow,.kicker{display:inline-flex;align-items:center;gap:7px;color:var(--blue);font-size:11px;font-weight:850;letter-spacing:.14em}.hero h1{max-width:760px;margin:18px 0 22px;color:var(--navy);font-size:clamp(42px,5vw,70px);line-height:1.02;letter-spacing:-.045em}.hero h1 span{color:var(--blue)}.hero-lead{max-width:700px;color:#526980;font-size:clamp(17px,1.5vw,20px);line-height:1.7}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.primary-button,.secondary-button,.ghost-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:10px;font-weight:750;transition:.2s ease}.primary-button{padding:13px 18px;border:1px solid var(--blue);color:#fff;background:var(--blue);box-shadow:0 10px 24px rgba(37,99,235,.22)}.primary-button:hover{transform:translateY(-1px);background:#1f56ca}.primary-button:disabled{opacity:.65;cursor:wait}.secondary-button{padding:13px 18px;border:1px solid var(--line);background:#fff}.compact{padding:10px 14px;font-size:13px}.ghost-button{padding:10px 14px;border:1px solid var(--line);color:#4d6278;background:#fff}.hero-note{display:flex;gap:9px;align-items:flex-start;max-width:620px;margin-top:22px;color:#6c7e91;font-size:12px;line-height:1.5}.hero-note svg{flex:0 0 auto;color:var(--green)}.hero-visual{position:relative;display:flex;flex-direction:column;align-items:stretch;padding:36px;border:1px solid #dce7f2;border-radius:28px;background:linear-gradient(rgba(17,56,91,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(17,56,91,.045) 1px,transparent 1px),#fff;background-size:24px 24px;box-shadow:0 30px 70px rgba(30,61,94,.12)}.system-card{padding:22px;border:1px solid var(--line);border-radius:16px;background:#fff}.system-card strong{display:block;margin-top:9px;color:var(--navy);font-size:22px}.system-card p{margin:3px 0 15px;color:var(--muted);font-size:13px}.system-label{color:var(--blue);font-size:10px;font-weight:850;letter-spacing:.13em}.mini-row{display:flex;justify-content:space-between;margin-top:8px;padding:9px 11px;border-radius:8px;color:#486077;background:#f6f9fc;font-size:12px}.mini-row b{color:var(--green)}.mini-row.warning{background:#fff7ef}.mini-row.warning b{color:var(--red)}.flow-line{display:flex;align-items:center;gap:12px;margin:11px 25px;color:var(--blue)}.flow-line span{height:1px;flex:1;background:#bfd0e1}.detected-badge{display:flex;align-items:center;gap:8px;align-self:center;margin-top:16px;padding:9px 13px;border:1px solid #f0c8a0;border-radius:999px;color:#9c5b0f;background:#fff8ef;font-size:12px;font-weight:700}.section{padding:88px clamp(22px,7vw,110px)}.section-heading{max-width:850px;margin-bottom:40px}.section-heading.narrow{max-width:700px}.section-heading h2,.demo-top h2,.learning-section h2{margin:10px 0 12px;color:var(--navy);font-size:clamp(30px,3vw,44px);line-height:1.12;letter-spacing:-.03em}.section-heading p,.demo-top p,.learning-section p{color:var(--muted);line-height:1.7}.steps-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.step-card{position:relative;min-height:230px;padding:24px;border:1px solid var(--line);border-radius:16px;background:#fff}.step-card>svg:not(.step-arrow){margin-top:32px;color:var(--blue)}.step-number{position:absolute;top:18px;right:18px;color:#b1bdca;font-size:11px;font-weight:800}.step-card h3{margin:13px 0 9px;color:var(--navy);font-size:16px}.step-card p{margin:0;color:var(--muted);font-size:13px;line-height:1.65}.step-arrow{position:absolute;right:-18px;top:calc(50% - 10px);z-index:3;color:#9cb0c2}.demo-section{background:#eaf0f7}.demo-top{display:flex;justify-content:space-between;gap:36px;align-items:flex-end;margin-bottom:24px}.demo-top>div:first-child{max-width:760px}.demo-actions{display:flex;gap:8px;flex:0 0 auto}.workspace{display:grid;grid-template-columns:200px 1fr;min-height:590px;overflow:hidden;border:1px solid #d4dfeb;border-radius:18px;background:#fff;box-shadow:0 24px 60px rgba(24,55,84,.09)}.workspace-nav{padding:18px 12px;border-right:1px solid var(--line);background:#f7f9fc}.workspace-nav button{display:flex;align-items:center;gap:9px;width:100%;margin-bottom:5px;padding:10px 12px;border:0;border-radius:8px;color:#577086;background:transparent;font-size:13px;text-align:left}.workspace-nav button.active{color:var(--blue);background:#e7efff;font-weight:750}.workspace-content{padding:28px;min-width:0}.workspace-title{display:flex;justify-content:space-between;gap:22px;align-items:flex-start;padding-bottom:22px;border-bottom:1px solid var(--line)}.workspace-title>div{max-width:720px}.workspace-title>div>span,.eco-label{color:var(--blue);font-size:10px;font-weight:850;letter-spacing:.12em}.workspace-title h3{margin:7px 0;color:var(--navy);font-size:21px}.workspace-title p{margin:0;color:var(--muted);font-size:13px;line-height:1.55}.status-chip,.pass-rate{flex:0 0 auto;padding:7px 9px;border-radius:6px;color:#16704e;background:#e8f7f0;font-size:10px;font-weight:850;letter-spacing:.06em}.status-chip.open{color:#9b5a0e;background:#fff3df}.pass-rate{color:#1763b5;background:#e8f1ff;font-size:12px}.metrics-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:22px}.metric-card{padding:16px;border:1px solid var(--line);border-radius:10px;background:#fbfcfe}.metric-card span{display:block;color:var(--muted);font-size:11px}.metric-card strong{display:block;margin-top:7px;color:var(--navy);font-size:18px}.eco-card{display:grid;grid-template-columns:120px 1.4fr 1fr auto;gap:15px;align-items:center;margin-top:18px;padding:17px;border:1px solid var(--line);border-radius:10px}.eco-card strong{display:block;margin-top:4px;color:var(--navy)}.eco-card p,.eco-card span{margin:0;color:#536a7f;font-size:12px}.eco-card b{color:var(--green);font-size:11px}.empty-panel{display:grid;justify-items:center;margin-top:20px;padding:38px;border:1px dashed #c6d5e4;border-radius:12px;color:var(--muted);text-align:center}.empty-panel.tall{min-height:430px;align-content:center}.empty-panel svg{color:var(--blue)}.empty-panel h3{margin:12px 0 5px;color:var(--navy)}.empty-panel p{max-width:500px;margin:0 0 16px;font-size:13px;line-height:1.55}.table-wrap{margin-top:18px;overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:12px}th{padding:11px;color:#75869a;background:#f7f9fc;font-size:10px;letter-spacing:.06em;text-align:left}td{padding:13px 11px;border-bottom:1px solid var(--line);color:#4c6379}td strong,td small{display:block}td strong{color:var(--navy)}td small{margin-top:3px;color:#8594a4}.result{display:inline-flex;align-items:center;gap:5px;font-weight:750}.result.pass{color:var(--green)}.result.fail,.missing{color:var(--red)}.results-list{margin-top:16px}.validation-row{display:grid;grid-template-columns:38px 155px minmax(220px,1fr) auto;gap:12px;align-items:center;padding:12px 4px;border-bottom:1px solid var(--line)}.result-icon{display:grid;place-items:center;width:32px;height:32px;border-radius:8px}.result-icon.pass{color:var(--green);background:#eaf7f1}.result-icon.fail{color:var(--red);background:#fff0f0}.validation-row>div:nth-child(2) strong,.validation-row>div:nth-child(2) span,.validation-issue strong,.validation-issue span{display:block}.validation-row>div:nth-child(2) strong{color:var(--navy);font-size:12px}.validation-row>div:nth-child(2) span,.validation-issue span{margin-top:2px;color:#8492a1;font-size:11px}.validation-issue strong{color:#4b6278;font-size:12px}.severity{padding:5px 7px;border-radius:5px;font-size:9px;font-weight:850;letter-spacing:.05em}.severity.high{color:#b52f2f;background:#ffeded}.severity.medium{color:#9b6415;background:#fff3df}.severity.low{color:#16704e;background:#e7f7ef}.defect-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:18px}.defect-card{padding:16px;border:1px solid var(--line);border-radius:10px}.defect-top{display:flex;justify-content:space-between;align-items:center;color:#8090a0;font-size:10px;font-weight:800}.defect-card h4{margin:12px 0 4px;color:var(--navy);font-size:14px}.defect-card>p{margin:0 0 12px;color:var(--muted);font-size:11px}.defect-card dl{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:0 0 12px}.defect-card dl div{padding:9px;border-radius:7px;background:#f7f9fc}.defect-card dt{color:#8a99a8;font-size:9px}.defect-card dd{margin:3px 0 0;color:#445d74;font-size:11px;font-weight:700}.architecture-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:15px;align-items:center}.architecture-flow>svg{color:#8da2b7}.architecture-box{display:grid;justify-items:start;min-height:160px;padding:24px;border:1px solid var(--line);border-radius:14px;background:#fff}.architecture-box svg{color:var(--blue)}.architecture-box strong{margin-top:24px;color:var(--navy)}.architecture-box span{margin-top:5px;color:var(--muted);font-size:12px}.learning-section{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:center;color:#fff;background:var(--navy)}.learning-section .kicker{color:#69c5df}.learning-section h2{color:#fff}.learning-section p{color:#c3d0db;font-size:16px}footer{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:26px clamp(22px,7vw,110px);color:#708095;background:#071b2d;font-size:12px}footer strong,footer span{display:block}footer strong{color:#fff;margin-bottom:4px}footer a{display:inline-flex;align-items:center;gap:7px;color:#fff}.spin{animation:spin .85s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:1000px){.hero{grid-template-columns:1fr}.hero-visual{max-width:720px}.steps-grid{grid-template-columns:repeat(2,1fr)}.step-arrow{display:none}.workspace{grid-template-columns:1fr}.workspace-nav{display:flex;gap:5px;overflow-x:auto;border-right:0;border-bottom:1px solid var(--line)}.workspace-nav button{width:auto;white-space:nowrap}}@media(max-width:760px){.nav-links a:not(.github-link){display:none}.hero{min-height:auto;padding-top:60px}.steps-grid,.metrics-grid,.defect-grid,.learning-section{grid-template-columns:1fr}.demo-top{align-items:flex-start;flex-direction:column}.workspace-content{padding:18px}.validation-row{grid-template-columns:34px 1fr auto}.validation-issue{grid-column:2/4}.eco-card{grid-template-columns:1fr}.architecture-flow{grid-template-columns:1fr}.architecture-flow>svg{transform:rotate(90deg);justify-self:center}footer{align-items:flex-start;flex-direction:column}}
